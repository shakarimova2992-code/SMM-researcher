# Секрет для подписи сессионной JWT-куки. Сгенерируйте случайную длинную строку
# (например: openssl rand -base64 32) и задайте в production-окружении (Vercel → Settings → Environment Variables).
SESSION_SECRET=change-me-to-a-long-random-string

# Ключ для служебного эндпоинта /api/account/reset (сброс привязки аккаунта пользователю).
# Не обязателен для базовой работы сайта — нужен только если хотите вручную сбрасывать
# привязку "1 ссылка = 1 аккаунт" через поддержку.
ADMIN_KEY=

# Email-адреса без ограничения "1 аккаунт на ссылку" (через запятую) — для тестирования
# самим владельцем продукта. Если переменная не задана, используется дефолт из
# lib/config.ts (сейчас там shakarimova2992@gmail.com). Задайте здесь, если хотите
# явно контролировать список через окружение (особенно если репозиторий публичный).
UNLIMITED_EMAILS=shakarimova2992@gmail.com

# --- Реальная отправка email (опционально) ---
# Пока переменные ниже не заданы, сайт работает в "dev-режиме": ссылка для входа
# просто показывается на экране вместо отправки на почту. Чтобы включить настоящую
# отправку через Resend — задайте ключ и раскомментируйте код в lib/mail.ts.
RESEND_API_KEY=

# --- Реальные данные Instagram через Apify (опционально) ---
# Если задан — /api/analyze при анализе конкретного аккаунта (шаги 2-3: топ-посты/Reels,
# отчёт) сначала пробует получить настоящий профиль и публикации через Apify
# (apify/instagram-profile-scraper + apify/instagram-scraper), и только при ошибке
# (закрытый профиль, неверный username, исчерпан лимит) тихо откатывается на мок —
# с честной пометкой в интерфейсе, какие данные показаны. Если не задан — работает
# только мок-режим, как раньше. Получить токен: apify.com → Settings → Integrations → API token.
# Поиск топ-аккаунтов по нише/городу (шаг 1) пока остаётся на мок-данных в любом случае —
# для него нужен отдельный источник (хэштег/локация-скрейпинг), это следующий шаг.
APIFY_API_TOKEN=
