# Секрет для подписи сессионной JWT-куки. Сгенерируйте случайную длинную строку
# (например: openssl rand -base64 32) и задайте в production-окружении (Vercel → Settings → Environment Variables).
SESSION_SECRET=change-me-to-a-long-random-string

# Ключ для служебного эндпоинта /api/account/reset (сброс привязки аккаунта пользователю).
# Не обязателен для базовой работы сайта — нужен только если хотите вручную сбрасывать
# привязку "1 ссылка = 1 аккаунт" через поддержку.
ADMIN_KEY=

# --- Реальная отправка email (опционально) ---
# Пока переменные ниже не заданы, сайт работает в "dev-режиме": ссылка для входа
# просто показывается на экране вместо отправки на почту. Чтобы включить настоящую
# отправку через Resend — задайте ключ и раскомментируйте код в lib/mail.ts.
RESEND_API_KEY=
